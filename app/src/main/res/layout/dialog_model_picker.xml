<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#18181b"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🧠 Seleccionar Modelo IA"
            android:textColor="#f4f4f5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_close_model_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#a1a1aa"
            android:textSize="20sp"
            android:padding="6dp" />
    </LinearLayout>

    <!-- Search Input -->
    <EditText
        android:id="@+id/et_search_model"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#27272a"
        android:hint="🔍 Buscar modelo (ej: flash, gemini, deepseek)..."
        android:textColorHint="#71717a"
        android:textColor="#f4f4f5"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:imeOptions="actionSearch" />

    <!-- Models List Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:id="@+id/container_models_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Custom Model Button -->
    <Button
        android:id="@+id/btn_custom_model"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#3f3f46"
        android:text="✏️ Ingresar modelo personalizado..."
        android:textColor="#e4e4e7"
        android:textSize="13sp" />

</LinearLayout>
