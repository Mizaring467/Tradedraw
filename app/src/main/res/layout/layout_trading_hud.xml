<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hud_panel"
    android:padding="4dp"
    android:elevation="12dp">

    <!-- LÍNEA 1 DE CABECERA: Modo, Estrategia, Timer, Opacidad y Toggle Minimizar -->
    <LinearLayout
        android:id="@+id/hud_header_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/hud_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[OFF]"
            android:textColor="#94a3b8"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/hud_strategy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto"
            android:textColor="#e2e8f0"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="· 1D ⚪"
            android:textColor="#38bdf8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginStart="3dp" />

        <TextView
            android:id="@+id/hud_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ⏱️ :00s"
            android:textColor="#facc15"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

        <!-- Botón de Opacidad -->
        <TextView
            android:id="@+id/hud_btn_opacity"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text=" 👁️ 70% "
            android:textColor="#38bdf8"
            android:textSize="8sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_hud_chip"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="3dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Botón de Chat con Agente IA -->
        <TextView
            android:id="@+id/hud_btn_chat"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text=" 💬 Chat "
            android:textColor="#a855f7"
            android:textSize="8sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_hud_chip"
            android:layout_marginStart="4dp"
            android:paddingHorizontal="3dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Botón Minimizar / Desplegar (Colapsado por defecto con ▼) -->
        <TextView
            android:id="@+id/hud_btn_collapse"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:text="▼"
            android:textColor="#cbd5e1"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_hud_chip"
            android:layout_marginStart="3dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- LÍNEA 2 DE CABECERA: W/L, Winrate, Martingala y Termómetro (Ultra-compacto) -->
    <LinearLayout
        android:id="@+id/hud_header_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/hud_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="W: 0 | L: 0"
            android:textColor="#22c55e"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_winrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" (0%)"
            android:textColor="#94a3b8"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/hud_martingale_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" [M0]"
            android:textColor="#fb923c"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:layout_marginStart="2dp" />

        <!-- Termómetro Compacto -->
        <TextView
            android:id="@+id/hud_power_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 50% CALL ==== 50% PUT ]"
            android:textColor="#38bdf8"
            android:textSize="8sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- CONTENEDOR DETALLADO (Colapsado / Oculto por defecto para no obstruir el gráfico) -->
    <LinearLayout
        android:id="@+id/hud_details_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="3dp"
        android:visibility="gone">

        <!-- Estado / Cooldown -->
        <TextView
            android:id="@+id/hud_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚪ En espera"
            android:textColor="#cbd5e1"
            android:textSize="8.5sp"
            android:layout_marginTop="1dp" />

        <!-- Diagnóstico de Cámara / Visión -->
        <TextView
            android:id="@+id/hud_diag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📷 Frames: 0 | Visión: OK"
            android:textColor="#94a3b8"
            android:textSize="8sp"
            android:layout_marginTop="1dp" />

        <!-- BLOQUE DIDÁCTICO: Tendencia Explicada y Próximo Movimiento Planeado -->
        <LinearLayout
            android:id="@+id/hud_didactic_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_signal_idle"
            android:padding="3dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/hud_trend_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📈 Tendencia: Lateral / Dojis (50%)"
                android:textColor="#38bdf8"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hud_trend_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analizando confluencia de soporte y resistencia..."
                android:textColor="#94a3b8"
                android:textSize="7.5sp"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/hud_planned_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Plan: Vigilando confirmación de ruptura o rebote"
                android:textColor="#facc15"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tarjeta de Señal Operativa -->
        <LinearLayout
            android:id="@+id/hud_signal_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_signal_idle"
            android:padding="3dp"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/hud_signal_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪ EN ESPERA DE SEÑAL"
                android:textColor="#cbd5e1"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hud_signal_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vigilando patrones de acción del precio..."
                android:textColor="#94a3b8"
                android:textSize="8sp"
                android:layout_marginTop="1dp" />

            <TextView
                android:id="@+id/hud_signal_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#facc15"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Pista / Estado de la Estrategia -->
        <TextView
            android:id="@+id/hud_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚪ En espera"
            android:textColor="#94a3b8"
            android:textSize="8sp"
            android:layout_marginTop="1dp" />

        <!-- Botones de Acción (+W, +L, ↺ S/R IA) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <Button
                android:id="@+id/hud_btn_win"
                android:layout_width="40dp"
                android:layout_height="22dp"
                android:text="+W"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/bg_hud_btn_win"
                android:padding="0dp" />

            <Button
                android:id="@+id/hud_btn_loss"
                android:layout_width="40dp"
                android:layout_height="22dp"
                android:text="+L"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/bg_hud_btn_loss"
                android:layout_marginStart="3dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/hud_btn_recalc_ai"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:text="↺ S/R"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/bg_hud_btn_recalc"
                android:layout_marginStart="5dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
