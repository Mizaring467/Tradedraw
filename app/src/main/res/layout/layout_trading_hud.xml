<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_hud_panel"
    android:padding="5dp"
    android:elevation="14dp">

    <!-- LÍNEA 1 DE CABECERA: Modo, Estrategia, Timer, Opacidad, Chat y Minimizar -->
    <LinearLayout
        android:id="@+id/hud_header_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/hud_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[AUTO]"
            android:textColor="#22c55e"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:paddingEnd="3dp" />

        <TextView
            android:id="@+id/hud_strategy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto"
            android:textColor="#e2e8f0"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="· 1D 🟢"
            android:textColor="#38bdf8"
            android:textSize="9sp"
            android:textStyle="bold"
            android:layout_marginStart="3dp" />

        <TextView
            android:id="@+id/hud_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ⏱️ :00s"
            android:textColor="#facc15"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:layout_marginStart="5dp" />

        <!-- Botón de Opacidad -->
        <TextView
            android:id="@+id/hud_btn_opacity"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text=" 👁️ 70% "
            android:textColor="#38bdf8"
            android:textSize="8sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_hud_chip"
            android:layout_marginStart="5dp"
            android:paddingHorizontal="3dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Botón de Chat con Agente IA -->
        <TextView
            android:id="@+id/hud_btn_chat"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:text=" 💬 Agente "
            android:textColor="#a855f7"
            android:textSize="8sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_hud_chip"
            android:layout_marginStart="3dp"
            android:paddingHorizontal="3dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Botón Minimizar / Desplegar -->
        <TextView
            android:id="@+id/hud_btn_collapse"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:text="▼"
            android:textColor="#cbd5e1"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_hud_chip"
            android:layout_marginStart="3dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- BARRA DESLIZANTE DE OPACIDAD -->
    <LinearLayout
        android:id="@+id/hud_opacity_slider_container"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_hud_chip"
        android:paddingHorizontal="6dp"
        android:layout_marginTop="2dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👁️ Opacidad"
            android:textColor="#38bdf8"
            android:textSize="8sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/hud_seek_opacity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="80"
            android:progress="50"
            android:thumbTint="#38bdf8"
            android:progressTint="#38bdf8"
            android:progressBackgroundTint="#334155" />

        <TextView
            android:id="@+id/hud_txt_opacity_value"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="70%"
            android:gravity="end"
            android:textColor="#f8fafc"
            android:textSize="8sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- LÍNEA 2 DE CABECERA: W/L, Winrate, Martingala y Termómetro Micro-Ticks -->
    <LinearLayout
        android:id="@+id/hud_header_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/hud_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="W: 0 | L: 0"
            android:textColor="#22c55e"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_winrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" (0%)"
            android:textColor="#94a3b8"
            android:textSize="8.5sp" />

        <TextView
            android:id="@+id/hud_martingale_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" [M0]"
            android:textColor="#fb923c"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:layout_marginStart="2dp" />

        <!-- Termómetro Compacto de Ticks / Flujo -->
        <TextView
            android:id="@+id/hud_power_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ WS Headless: ▲ ALCISTA (641.8674) ]"
            android:textColor="#22c55e"
            android:textSize="8sp"
            android:textStyle="bold"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <!-- CONTENEDOR DETALLADO DEL ANÁLISIS DEL AGENTE (Persistente, claro y sin parpadeos) -->
    <LinearLayout
        android:id="@+id/hud_details_container"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="3dp"
        android:visibility="visible">

        <!-- ALERTA VISUAL DESTACADA MODO HÍBRIDO (¡PULSA MANUAL!) -->
        <LinearLayout
            android:id="@+id/hud_manual_fallback_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_chip"
            android:padding="6dp"
            android:layout_marginBottom="3dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/hud_manual_fallback_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 ¡PULSA MANUAL! 🚨"
                android:textColor="#ffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hud_manual_fallback_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲ CALL (SUBE) ▲"
                android:textColor="#22c55e"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- TARJETA 1: LO QUE VE EL AGENTE (Mercado & Enlace WebSocket 0ms) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_chip"
            android:padding="4dp"
            android:layout_marginBottom="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/hud_diag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🟢 WS Activo: 641.8674 (0ms) | Headless"
                    android:textColor="#22c55e"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hud_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🟢 Operativa Activa"
                    android:textColor="#38bdf8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Micro-Velocidad y Flujo de Tick -->
            <TextView
                android:id="@+id/hud_tick_velocity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚡ Micro-Velocidad: +0.038 px/s ▲ Impulso Alcista"
                android:textColor="#4ade80"
                android:textSize="7.5sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- TARJETA 2: ESTRUCTURA DE MERCADO Y RAZONAMIENTO DEL AGENTE -->
        <LinearLayout
            android:id="@+id/hud_didactic_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_signal_idle"
            android:padding="4dp"
            android:layout_marginBottom="2dp">

            <!-- Fila 1: Tendencia y Probabilidad Estimada -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/hud_trend_badge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📈 Tendencia: ALCISTA"
                    android:textColor="#4ade80"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hud_prob_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prob: 88%"
                    android:textColor="#38bdf8"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Fila 2: Patrón Cuantitativo Detectado -->
            <TextView
                android:id="@+id/hud_detected_pattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔍 Patrón: Rechazo Mecha en Soporte"
                android:textColor="#f8fafc"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />

            <!-- Fila 3: Estado del Filtro S/R y Niveles -->
            <TextView
                android:id="@+id/hud_sr_filter_badge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡️ Filtro S/R: En Soporte Clave ✓ (S: 641.61 · R: 642.12)"
                android:textColor="#cbd5e1"
                android:textSize="7.5sp"
                android:layout_marginTop="1dp" />

            <!-- Fila 4: Plan de Acción Táctico Inmediato -->
            <TextView
                android:id="@+id/hud_planned_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎯 Plan: Preparar orden CALL para ventana sniper :59s"
                android:textColor="#facc15"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- TARJETA 3: ESTADO DE SEÑAL / TRADE EN CURSO -->
        <LinearLayout
            android:id="@+id/hud_signal_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hud_chip"
            android:padding="4dp"
            android:layout_marginBottom="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/hud_signal_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚪ EN ESPERA DE DISPARO :59s"
                    android:textColor="#cbd5e1"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hud_signal_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#facc15"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/hud_signal_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filtros activos: Cooldown OK | Racha OK | Momentum Confirmado"
                android:textColor="#94a3b8"
                android:textSize="7.5sp"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <!-- Pista de Estrategia -->
        <TextView
            android:id="@+id/hud_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚪ Estrategia: Auto-Adaptativa"
            android:textColor="#64748b"
            android:textSize="7.5sp"
            android:layout_marginBottom="2dp" />

        <!-- Botones de Acción (+W, +L, ↺ S/R) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/hud_btn_win"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:text="+W"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/bg_hud_btn_win"
                android:padding="0dp" />

            <Button
                android:id="@+id/hud_btn_loss"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1"
                android:text="+L"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:background="@drawable/bg_hud_btn_loss"
                android:layout_marginStart="3dp"
                android:padding="0dp" />

            <Button
                android:id="@+id/hud_btn_recalc_ai"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:layout_weight="1.2"
                android:text="✓ S/R [Auto]"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="#34d399"
                android:background="@drawable/bg_hud_btn_recalc"
                android:layout_marginStart="3dp"
                android:padding="0dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
