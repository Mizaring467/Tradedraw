<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hud_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F00a0a0f"
    android:padding="8dp"
    android:elevation="18dp">

    <!-- Fila 1: Modo, Estrategia y Radar de Racha de Velas -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/hud_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[OFF]"
            android:textColor="#94a3b8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/hud_strategy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estrat: MT Combo"
            android:textColor="#e2e8f0"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/hud_streak_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="· 1D ⚪"
            android:textColor="#38bdf8"
            android:textSize="10sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Fila 2: W/L, Winrate, Martingala y Temporizador de Vela 60s -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="3dp">

        <TextView
            android:id="@+id/hud_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="W: 0 | L: 0"
            android:textColor="#22c55e"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hud_winrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" (0%)"
            android:textColor="#94a3b8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/hud_martingale_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" [M0]"
            android:textColor="#fb923c"
            android:textSize="10sp"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/hud_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ⏱️ :00s"
            android:textColor="#facc15"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Fila 3: Termómetro de Señal (% CALL vs % PUT) -->
    <TextView
        android:id="@+id/hud_power_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ 50% CALL █████░░░░░ 50% PUT ]"
        android:textColor="#38bdf8"
        android:textSize="9sp"
        android:textStyle="bold"
        android:layout_marginTop="3dp" />

    <!-- Fila 4: Diagnóstico de Cámara / Visión -->
    <TextView
        android:id="@+id/hud_diag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📷 Frames: 0 | Visión: OK"
        android:textColor="#94a3b8"
        android:textSize="9sp"
        android:layout_marginTop="2dp" />

    <!-- Fila 5: Pista / Estado de la Estrategia -->
    <TextView
        android:id="@+id/hud_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚪ En espera"
        android:textColor="#cbd5e1"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />

    <!-- Fila 6: Estado / Cooldown / Strike Price ITM-OTM -->
    <TextView
        android:id="@+id/hud_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚪ En espera"
        android:textColor="#cbd5e1"
        android:textSize="10sp"
        android:layout_marginTop="2dp" />

    <!-- Fila 7: Botones rápidos para registrar resultado en Demo -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp">

        <Button
            android:id="@+id/hud_btn_win"
            android:layout_width="45dp"
            android:layout_height="28dp"
            android:text="+W"
            android:textSize="9sp"
            android:textColor="#ffffff"
            android:backgroundTint="#15803d"
            android:padding="0dp" />

        <Button
            android:id="@+id/hud_btn_loss"
            android:layout_width="45dp"
            android:layout_height="28dp"
            android:text="+L"
            android:textSize="9sp"
            android:textColor="#ffffff"
            android:backgroundTint="#b91c1c"
            android:layout_marginStart="4dp"
            android:padding="0dp" />
    </LinearLayout>

</LinearLayout>
