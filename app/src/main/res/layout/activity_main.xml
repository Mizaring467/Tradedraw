<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="20dp"
    android:background="#070A12">

    <!-- Header Card con Logo y Título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_hud_panel"
        android:padding="20dp"
        android:layout_marginBottom="20dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/app_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="10dp"
            android:contentDescription="TradeDraw Logo" />

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 TradeDraw Pro"
            android:textSize="24sp"
            android:textColor="#F8FAFC"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Motor Cuantitativo WebSocket Headless (0ms) y Auto-Trading"
            android:textSize="12sp"
            android:textColor="#38BDF8"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Botones de Acción Principal: Protagonismo Total a WebSocket Headless -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- BOTÓN PRINCIPAL PROTAGONISTA: WebSocket Headless -->
        <Button
            android:id="@+id/btn_headless"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🚀 INICIAR TRADE PRO (WebSocket 0ms)"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:elevation="8dp"
            android:layout_marginBottom="10dp" />

        <!-- Vincular Sesión Binomo -->
        <Button
            android:id="@+id/btn_link_binomo"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="🔑 Vincular Cuenta Binomo (Token WebSocket)"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Activar Accesibilidad -->
        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="🛡️ Activar Accesibilidad (Auto-Trading)"
            android:backgroundTint="#1E293B"
            android:textColor="#E2E8F0"
            android:textSize="12.5sp"
            android:layout_marginBottom="14dp" />

        <!-- OPCIÓN SECUNDARIA / LEGADA: Visión IA (Minimizada) -->
        <Button
            android:id="@+id/boton"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="⚡ Modo Secundario: Visión IA (Grabación de Pantalla)"
            android:backgroundTint="#0F172A"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:layout_marginBottom="10dp" />

        <!-- Detener Overlay -->
        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="🛑 Detener TradeDraw"
            android:backgroundTint="#201E293B"
            android:textColor="#F43F5E"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
