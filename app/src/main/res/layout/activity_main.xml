<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#070A12">

    <!-- Header Card con Logo y Título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_hud_panel"
        android:padding="24dp"
        android:layout_marginBottom="24dp">

        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/app_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="12dp"
            android:contentDescription="TradeDraw Logo" />

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 TradeDraw Pro"
            android:textSize="26sp"
            android:textColor="#F8FAFC"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suite Cuantitativa de Análisis y Auto-Trading"
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Botones de Acción Principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/boton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⚡ Iniciar Overlay (Visión IA)"
            android:backgroundTint="#7C3AED"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="6dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🛡️ Activar Accesibilidad (Auto-Trading)"
            android:backgroundTint="#1E293B"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="🛑 Detener Overlay"
            android:backgroundTint="#331E293B"
            android:textColor="#F43F5E"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
